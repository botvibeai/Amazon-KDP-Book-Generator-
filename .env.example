# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# COMET_API_KEY: Key for CometAPI (500+ OpenAI/Claude/Llama/DeepSeek models).
COMET_API_KEY="MY_COMET_API_KEY"

# AIML_API_KEY: Key for AI/ML API (900+ multi-provider frontier models).
AIML_API_KEY="MY_AIML_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

